{% extends 'admin_panel/base.html' %}
{% load static %}

{% block title %}Eliminar Proveedor - Panel Admin{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{% url 'admin_panel:dashboard' %}">Inicio</a></span>
    <span class="breadcrumb-item"><a href="{% url 'admin_panel:proveedores_lista' %}">Proveedores</a></span>
    <span class="breadcrumb-item">Eliminar</span>
{% endblock %}

{% block content %}
<div class="fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">Eliminar Proveedor</h1>
            <p class="page-subtitle">Confirma la eliminación del proveedor</p>
        </div>
        <a href="{% url 'admin_panel:proveedores_lista' %}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card" style="max-width: 600px; margin: 0 auto;">
        <div class="card-body" style="text-align: center; padding: 40px;">
            <div style="width: 80px; height: 80px; border-radius: 50%; background: #f8d7da; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                <i class="fas fa-exclamation-triangle" style="font-size: 2.5rem; color: var(--danger);"></i>
            </div>
            
            <h2 style="color: var(--text-primary); margin-bottom: 12px;">¿Eliminar proveedor?</h2>
            <p style="color: var(--text-secondary); margin-bottom: 8px;">
                Estás a punto de eliminar a <strong>{{ proveedor.empresa }}</strong> (RFC: {{ proveedor.rfc }}).
            </p>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 32px;">
                El proveedor será marcado como inactivo. Podrás reactivarlo más adelante si lo necesitas.
            </p>

            <form method="post" style="display: flex; gap: 12px; justify-content: center;">
                {% csrf_token %}
                <a href="{% url 'admin_panel:proveedores_lista' %}" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Sí, Eliminar
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}