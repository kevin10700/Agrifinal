        <div class="global-search">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Buscar..." id="globalSearch">
        </div>
        
        <!-- Notificaciones con alertas reales -->
        <div class="header-notifications" id="headerNotifications" style="position: relative;">
            <a href="{% url 'admin_panel:dashboard' %}" class="header-icon-btn" title="Notificaciones" id="notifToggle">
                <i class="fas fa-bell"></i>
                {% if alertas_total > 0 %}
                <span class="badge" style="background: var(--danger);">{{ alertas_total }}</span>
                {% endif %}
            </a>
            {% if alertas_total > 0 %}
            <div class="notif-dropdown" id="notifDropdown" style="display: none; position: absolute; right: 0; top: 100%; margin-top: 8px; width: 320px; max-height: 400px; overflow-y: auto; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--border-radius-sm); box-shadow: var(--shadow-lg); z-index: 1000;">
                <div style="padding: 12px 16px; border-bottom: 1px solid var(--border-color); font-weight: 600; color: var(--text-primary); display: flex; justify-content: space-between; align-items: center;">
                    <span>Alertas</span>
                    <span style="font-size: 0.8rem; color: var(--text-muted);">{{ alertas_total }} pendientes</span>
                </div>
                {% if alertas.productos_sin_stock > 0 %}
                <a href="{% url 'admin_panel:inventario' %}" style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; text-decoration: none; border-bottom: 1px solid var(--border-color); color: var(--text-primary);">
                    <i class="fas fa-exclamation-circle" style="color: var(--danger); font-size: 1.2rem;"></i>
                    <div>
                        <div style="font-weight: 500; font-size: 0.9rem;">Productos sin stock</div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">{{ alertas.productos_sin_stock }} producto(s)</div>
                    </div>
                </a>
                {% endif %}
                {% if alertas.productos_bajo_stock > 0 %}
                <a href="{% url 'admin_panel:inventario' %}" style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; text-decoration: none; border-bottom: 1px solid var(--border-color); color: var(--text-primary);">
                    <i class="fas fa-exclamation-triangle" style="color: var(--warning); font-size: 1.2rem;"></i>
                    <div>
                        <div style="font-weight: 500; font-size: 0.9rem;">Bajo stock</div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">{{ alertas.productos_bajo_stock }} producto(s)</div>
                    </div>
                </a>
                {% endif %}
                {% if alertas.pedidos_pendientes > 0 %}
                <a href="{% url 'admin_panel:pedidos_lista' %}" style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; text-decoration: none; border-bottom: 1px solid var(--border-color); color: var(--text-primary);">
                    <i class="fas fa-clock" style="color: var(--info); font-size: 1.2rem;"></i>
                    <div>
                        <div style="font-weight: 500; font-size: 0.9rem;">Pedidos pendientes</div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">{{ alertas.pedidos_pendientes }} pedido(s)</div>
                    </div>
                </a>
                {% endif %}
                {% if alertas.pedidos_cancelados > 0 %}
                <a href="{% url 'admin_panel:pedidos_lista' %}" style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; text-decoration: none; color: var(--text-primary);">
                    <i class="fas fa-times-circle" style="color: var(--danger); font-size: 1.2rem;"></i>
                    <div>
                        <div style="font-weight: 500; font-size: 0.9rem;">Pedidos cancelados</div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">{{ alertas.pedidos_cancelados }} pedido(s)</div>
                    </div>
                </a>
                {% endif %}
            </div>
            {% endif %}
        </div>
        
        <!-- Toggle de Tema -->
        <button class="header-icon-btn" id="themeToggle" title="Cambiar tema">
            <i class="fas fa-moon"></i>
        </button>
        
        <!-- Perfil de Usuario -->
        <div class="user-profile" id="userProfile">
            {% if user.foto_perfil %}
                <img src="{{ user.foto_perfil.url }}" alt="{{ user.nombre_completo }}" class="user-avatar">
            {% else %}
                <div class="user-avatar" style="background: var(--primary-color); color: white; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                    {{ user.nombre|first|upper }}
                </div>
            {% endif %}
            <div class="user-info">
                <span class="user-name">{{ user.nombre_completo }}</span>
                <span class="user-role">Administrador</span>
            </div>
            <i class="fas fa-chevron-down" style="font-size: 0.8rem; color: var(--text-muted);"></i>
        </div>
        
        <!-- Cerrar Sesion -->
        <a href="{% url 'usuarios:logout' %}" class="header-icon-btn" title="Cerrar sesion">
            <i class="fas fa-sign-out-alt"></i>
        </a>
    </div>
</header>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const notifToggle = document.getElementById("notifToggle");
    const notifDropdown = document.getElementById("notifDropdown");
    if (notifToggle && notifDropdown) {
        notifToggle.addEventListener("click", (e) => {
            e.preventDefault();
            notifDropdown.style.display = notifDropdown.style.display === "none" ? "block" : "none";
        });
        document.addEventListener("click", (e) => {
            if (!notifToggle.contains(e.target) && !notifDropdown.contains(e.target)) {
                notifDropdown.style.display = "none";
            }
        });
    }
});
</script>
"""

