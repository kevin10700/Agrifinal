# Perfil HTML
perfil_content = """{% extends 'admin_panel/base.html' %}
{% load static %}

{% block title %}Mi Perfil - Panel Admin{% endblock %}

{% block breadcrumb %}
    <span class="breadcrumb-item"><a href="{% url 'admin_panel:dashboard' %}">Inicio</a></span>
    <span class="breadcrumb-item">Mi Perfil</span>
{% endblock %}

{% block content %}
<div class="fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">Mi Perfil</h1>
            <p class="page-subtitle">Gestiona tu informacion personal</p>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 340px 1fr; gap: 24px; align-items: start;">
        <!-- Tarjeta de perfil -->
        <div class="card" style="text-align: center;">
            <div class="card-body" style="padding: 32px;">
                {% if user.foto_perfil %}
                <img src="{{ user.foto_perfil.url }}" alt="{{ user.nombre_completo }}" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; margin-bottom: 16px; border: 4px solid var(--primary-color);">
                {% else %}
                <div style="width: 120px; height: 120px; border-radius: 50%; background: var(--primary-color); color: white; display: flex; align-items: center; justify-content: center; font-size: 3rem; font-weight: bold; margin: 0 auto 16px;">
                    {{ user.nombre|first|upper }}
                </div>
                {% endif %}
                <h2 style="color: var(--text-primary); margin-bottom: 4px;">{{ user.nombre_completo }}</h2>
                <p style="color: var(--text-muted); margin-bottom: 16px;">{{ user.email }}</p>
                <span class="badge badge-primary" style="font-size: 0.85rem; padding: 6px 16px;">
                    <i class="fas fa-shield-alt"></i> Administrador
                </span>
                <div style="margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--border-color); display: grid; gap: 12px; text-align: left;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted); font-size: 0.85rem;">Usuario</span>
                        <span style="font-weight: 500; color: var(--text-primary);">{{ user.username }}</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted); font-size: 0.85rem;">Telefono</span>
                        <span style="font-weight: 500; color: var(--text-primary);">{{ user.telefono|default:"No registrado" }}</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted); font-size: 0.85rem;">Miembro desde</span>
                        <span style="font-weight: 500; color: var(--text-primary);">{{ user.date_joined|date:"d/m/Y" }}</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulario de edicion -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-user-edit" style="color: var(--primary-color);"></i> Editar Informacion</h3>
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    {% csrf_token %}
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px;">
                        <div>
                            <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--text-secondary);">Nombre(s)</label>
                            <input type="text" name="nombre" value="{{ user.nombre }}" style="width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: var(--border-radius-sm); background: var(--bg-card); color: var(--text-primary);">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--text-secondary);">Apellido paterno</label>
                            <input type="text" name="apellido_paterno" value="{{ user.apellido_paterno }}" style="width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: var(--border-radius-sm); background: var(--bg-card); color: var(--text-primary);">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--text-secondary);">Apellido materno</label>
                            <input type="text" name="apellido_materno" value="{{ user.apellido_materno }}" style="width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: var(--border-radius-sm); background: var(--bg-card); color: var(--text-primary);">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--text-secondary);">Correo electronico</label>
                            <input type="email" name="email" value="{{ user.email }}" style="width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: var(--border-radius-sm); background: var(--bg-card); color: var(--text-primary);">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--text-secondary);">Telefono</label>
                            <input type="tel" name="telefono" value="{{ user.telefono }}" style="width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: var(--border-radius-sm); background: var(--bg-card); color: var(--text-primary);">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--text-secondary);">Fecha de nacimiento</label>
                            <input type="date" name="fecha_nacimiento" value="{{ user.fecha_nacimiento|date:'Y-m-d' }}" style="width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: var(--border-radius-sm); background: var(--bg-card); color: var(--text-primary);">
                        </div>
                        <div style="grid-column: 1 / -1;">
                            <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--text-secondary);">Foto de perfil</label>
                            <input type="file" name="foto_perfil" accept="image/*" style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: var(--border-radius-sm); background: var(--bg-card); color: var(--text-primary);">
                        </div>
                    </div>
                    <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color);">
                        <button type="reset" class="btn btn-secondary">
                            <i class="fas fa-undo"></i> Restablecer
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
"""

